<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    The DataStore preferences file holds the user's personal TMDB access
    token; it must never leave the device via cloud backup or device
    transfer (e.g. switching phones with a USB cable).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cinelog_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cinelog_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
