<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for devices older than API 31.
    The DataStore preferences file holds the user's personal TMDB access
    token; it must never leave the device via cloud backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/cinelog_preferences.preferences_pb" />
</full-backup-content>
